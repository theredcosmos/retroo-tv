# Copy to .env (git-ignored) and fill in real values before `docker compose up`.
ORACLE_PASSWORD=change-me-sys-password
DB_PASSWORD=change-me-app-password
# Leave empty to disable the admin API entirely.
ADMIN_API_KEY=

# ---- Production on your own domain (docker-compose.prod.yml + Caddy) ----
# Public hostname whose DNS A/AAAA record points at this server.
DOMAIN=retroo.example.com
# Optional: Let's Encrypt expiry notices go here.
ACME_EMAIL=
